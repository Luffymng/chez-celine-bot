# Токен Telegram-бота ресторана
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Админы ресторана (ч/з запятую)
ADMIN_IDS=1180896379

# ID ресторана в БД платформы (заполняется веб-кабинетом)
RESTAURANT_ID=1

# Строка подключения к Postgres (общая для всех ресторанов)
DATABASE_URL=postgresql://user:pass@host:5432/restaurant_saas

# Как часто проверять напоминания (сек)
POLL_INTERVAL=60

# === Веб-конструктор ===
# Секрет для сессий кабинета
CABINET_SECRET=change-me
# Админ платформы (увидит всех пользователей и все рестораны)
ADMIN_EMAIL=admin@bot.local
ADMIN_PASSWORD=admin123
# Цена тарифа
PLAN_PRICE=1500
# Дней бесплатного периода
TRIAL_DAYS=7